rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------
    // Helper Functions
    // -------------------------

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function currentUserData() {
      return currentUser().data;
    }

    function tenantId() {
      return currentUserData().tenantId;
    }

    function role() {
      return currentUserData().role;
    }

    function isAdmin() {
      return role() == "Administrator";
    }

    function isSupervisor() {
      return role() == "Supervisor";
    }

    function isOfficer() {
      return role() == "Officer";
    }

    function sameTenant() {
      return resource.data.tenantId == tenantId();
    }

    function sameTenantOnCreate() {
      return request.resource.data.tenantId == tenantId();
    }

    // -------------------------
    // Identity
    // -------------------------

    match /users/{userId} {
      allow read:
        if signedIn()
        && request.auth.uid == userId;

      allow create, update, delete: if false;
    }

    match /userSettings/{userId} {
      allow read:
        if signedIn()
        && request.auth.uid == userId;

      allow update:
        if signedIn()
        && request.auth.uid == userId;

      allow create, delete: if false;
    }

        // -------------------------
      // Employees
      // -------------------------

    match /employees/{employeeId} {

      // Read employees within the same tenant
      allow read:
        if signedIn()
        && sameTenant();

      // Administrators and Supervisors may create employees
      allow create:
        if signedIn()
        && sameTenantOnCreate()
        && (isAdmin() || isSupervisor());

      // Administrators and Supervisors may update employees
      allow update:
        if signedIn()
        && sameTenant()
        && (isAdmin() || isSupervisor());

      // Only Administrators may delete employees
      allow delete:
        if signedIn()
        && sameTenant()
        && isAdmin();
    }

     // -------------------------
    // Sites
    // -------------------------

    match /sites/{siteId} {

  allow read:
    if signedIn() &&
       sameTenant(resource.data.tenantId);

  allow create:
    if signedIn() &&
       sameTenantOnCreate() &&
       (
         isAdmin() ||
         isSupervisor()
       );

  allow update:
    if signedIn() &&
       sameTenant(resource.data.tenantId) &&
       (
         isAdmin() ||
         isSupervisor()
       );

  allow delete:
    if signedIn() &&
       sameTenant(resource.data.tenantId) &&
       isAdmin();
}

    // -------------------------
    // Shifts
    // -------------------------

match /shifts/{shiftId} {

  allow read:
    if signedIn() &&
       sameTenant(resource.data.tenantId);

  allow create:
    if signedIn() &&
       sameTenantOnCreate() &&
       (
         isAdmin() ||
         isSupervisor()
       );

  allow update:
    if signedIn() &&
       sameTenant(resource.data.tenantId) &&
       (
         isAdmin() ||
         isSupervisor()
       );

  allow delete:
    if signedIn() &&
       sameTenant(resource.data.tenantId) &&
       isAdmin();
}

    // -------------------------
    // OpenShifts
    // -------------------------

match /openShifts/{shiftId} {

  allow read:
    if signedIn() &&
       sameTenant(resource.data.tenantId);

  allow create:
    if signedIn() &&
       sameTenantOnCreate() &&
       (isAdmin() || isSupervisor());

  allow update:
    if signedIn() &&
       sameTenant(resource.data.tenantId) &&
       (
         isAdmin() ||
         isSupervisor() ||
         isOfficer()
       );

  allow delete:
    if signedIn() &&
       sameTenant(resource.data.tenantId) &&
       isAdmin();

}

 // -------------------------
    // TimeEntries
    // -------------------------

match /timeEntries/{timeEntryId} {

  allow read:
    if signedIn() &&
       sameTenant(resource.data.tenantId);

  allow create:
    if signedIn() &&
       sameTenantOnCreate() &&
       (
         isAdmin() ||
         isSupervisor() ||
         isOfficer()
       );

  allow update:
    if signedIn() &&
       sameTenant(resource.data.tenantId) &&
       (
         isAdmin() ||
         isSupervisor() ||
         isOfficer()
       );

  allow delete:
    if signedIn() &&
       sameTenant(resource.data.tenantId) &&
       isAdmin();
}

    // -------------------------
    // Incidents
    // -------------------------

match /incidents/{incidentId} {

  allow read:
    if isSignedIn() &&
       resource.data.tenantId == tenantId();

  allow create:
    if isSignedIn() &&
       (isAdmin() || isSupervisor() || isOfficer()) &&
       request.resource.data.tenantId == tenantId();

  allow update:
    if isSignedIn() &&
       (isAdmin() || isSupervisor() || isOfficer()) &&
       resource.data.tenantId == tenantId() &&
       request.resource.data.tenantId == tenantId();

  allow delete:
    if isSignedIn() &&
       isAdmin() &&
       resource.data.tenantId == tenantId();

}

        // -------------------------
    // Meetings
    // -------------------------

    match /meetings/{meetingId} {

      // Same-tenant users may read meetings
      allow read:
        if signedIn()
        && sameTenant();

      // Administrators and Supervisors may create meetings
      allow create:
        if signedIn()
        && sameTenantOnCreate()
        && (isAdmin() || isSupervisor());

      // Administrators and Supervisors may update meetings
      allow update:
        if signedIn()
        && sameTenant()
        && (isAdmin() || isSupervisor());

      // Only Administrators may delete meetings
      allow delete:
        if signedIn()
        && sameTenant()
        && isAdmin();
    }

    // -------------------------
    // Meeting Attendees
    // -------------------------

    match /meetings/{meetingId}/attendees/{attendeeId} {

      // Administrators and Supervisors may read all attendees.
      // An internal attendee may read their own record.
      allow read:
        if signedIn()
        && get(
          /databases/$(database)/documents/meetings/$(meetingId)
        ).data.tenantId == tenantId()
        && (
          isAdmin() ||
          isSupervisor() ||
          (
            resource.data.attendeeType == "internal" &&
            resource.data.userId == request.auth.uid
          )
        );

      // Administrators and Supervisors may add attendees.
      allow create:
        if signedIn()
        && get(
          /databases/$(database)/documents/meetings/$(meetingId)
        ).data.tenantId == tenantId()
        && (isAdmin() || isSupervisor());

      // Administrators and Supervisors may update attendees.
      //
      // Internal attendees may update only their own
      // participation fields.
      allow update:
        if signedIn()
        && get(
          /databases/$(database)/documents/meetings/$(meetingId)
        ).data.tenantId == tenantId()
        && (
          isAdmin() ||
          isSupervisor() ||
          (
            resource.data.attendeeType == "internal" &&
            resource.data.userId == request.auth.uid &&
            request.resource.data.attendeeType == "internal" &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                "responseStatus",
                "respondedAt",
                "attendanceStatus",
                "joinedAt",
                "leftAt"
              ])
          )
        );

      // Only Administrators may delete attendees.
      allow delete:
        if signedIn()
        && get(
          /databases/$(database)/documents/meetings/$(meetingId)
        ).data.tenantId == tenantId()
        && isAdmin();
    }
    // -------------------------
    // Everything else (temporary)
    // -------------------------

    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}